# Only needed when running the API outside Docker (`npm run dev`).
# With Docker Compose these come from the .env file in the project root instead.
#
# Quick local MongoDB:  docker run -d --name tp-mongo -p 127.0.0.1:27017:27017 mongo:6.0

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/textilepro

# Required in production (>= 32 random chars): openssl rand -hex 32
JWT_SECRET=

# Used once, to create the first admin when the database has no users yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
