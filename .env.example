# Copy this file to .env (or just run ./setup.sh, which fills in random secrets for you).
# `docker compose` reads .env automatically. Never commit the real .env.

# --- Required ----------------------------------------------------------------

# Signs admin login tokens. Use 32+ random characters:  openssl rand -hex 32
JWT_SECRET=

# MongoDB root password. Only read the first time the database volume is created.
# Any characters work; wrap it in single quotes if it contains $ or #  (e.g. 'pa$$word#1').
MONGO_ROOT_PASSWORD=

# --- First admin account -----------------------------------------------------
# Created automatically on first start, when the database has no users yet.
# The password needs at least 6 characters.
# (Lost the password later?  docker compose exec backend node create-admin.js <email> <new-password>)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------

# Port the site is published on. Point your Cloudflare Tunnel at http://localhost:<this>
HTTP_PORT=8080

# 127.0.0.1 = only this machine can reach it (use when cloudflared runs on the same host).
# 0.0.0.0   = also reachable from other devices on your LAN.
BIND_ADDRESS=0.0.0.0

# Docker Compose names the network and the database volume after this folder. If you rename
# or move the folder, pin the OLD name here so you keep the same database (the old name is
# the prefix of the volume shown by `docker volume ls`, e.g. fullstack_mongodb_data):
# COMPOSE_PROJECT_NAME=fullstack

# Run cloudflared inside this stack:  docker compose --profile tunnel up -d
# (or set COMPOSE_PROFILES=tunnel so a plain `docker compose up -d` includes it)
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
